	measure 'Color | p6_vis01' = Nexora.BarColor ( dim_company[company_name], [Production Line Efficiency %], 1, 1, "#B54708" )
		displayFolder: 90. Storytelling

	measure 'Color | p6_vis03' = Nexora.BarColor ( fact_workforce_monthly[department_name], [Total Workforce Payroll (USD)], 0, 1, "#0B2C5F" )
