	measure 'Title | p2_vis02' = Nexora.RankTitle ( dim_product[knit_woven_classification], [Shipped FOB Revenue (USD)], "usd", 0, 1, "{name} garments generate {share} of revenue" )
		displayFolder: 90. Storytelling

	measure 'Title | p2_vis03' = Nexora.TwoRatio ( [Statutory Minimum Wage (BDT)], [Output per Labour Hour (PCS)], "Since {y0}, the minimum wage rose {a} while output per labour hour rose only {b}" )
		displayFolder: 90. Storytelling

	measure 'Title | p3_vis01' = Nexora.RankTitle ( dim_buyer[buyer_name], [Shipped FOB Revenue (USD)], "usd", 0, 2, "Two buyers ({name}) generate {share} of revenue" )
		displayFolder: 90. Storytelling

	measure 'Title | p3_vis02' = Nexora.RankTitle ( dim_product[product_category], [Shipped FOB Revenue (USD)], "usd", 0, 1, "{name} lead with {value}, {share} of revenue" )
		displayFolder: 90. Storytelling

	measure 'Title | p3_vis03' = Nexora.RankTitle ( dim_buyer[market_classification], [Shipped FOB Revenue (USD)], "usd", 0, 1, "{name} markets still supply {share} of revenue" )
		displayFolder: 90. Storytelling

	measure 'Title | p4_vis01' = Nexora.RankTitle ( dim_supplier[origin_country], [Total Procurement Value (USD)], "usd", 0, 1, "{name} supplies {share} of procurement spend ({value})" )
		displayFolder: 90. Storytelling

	measure 'Title | p4_vis02' = Nexora.RankTitle ( dim_material[material_category], [BOM Material Wastage Rate %], "pct1", 0, 1, "{name} has the highest wastage rate at {value} (all materials: {total})" )
		displayFolder: 90. Storytelling

	measure 'Title | p4_vis03' = Nexora.RankTitle ( dim_supplier[domestic_import_classification], [Total Procurement Value (USD)], "usd", 0, 1, "{name} materials make up {share} of procurement spend" )
		displayFolder: 90. Storytelling

	measure 'Title | p5_vis01' = Nexora.TrendTitle ( [Days Inventory Outstanding (DIO)], "Days of inventory on hand", "days", "rose", "fell", 0 )
		displayFolder: 90. Storytelling

	measure 'Title | p5_vis02' = Nexora.RankTitle ( fact_inventory_snapshot_monthly[stock_type], [Closing Inventory Value (USD)], "usd", 0, 1, "{name} ties up {share} of closing inventory ({value})" )
		displayFolder: 90. Storytelling

	measure 'Title | p5_vis03' = Nexora.RankTitle ( fact_inventory_snapshot_monthly[ageing_bucket], [Closing Inventory Value (USD)], "usd", 0, 1, "{share} of closing inventory is {name} stock" )
		displayFolder: 90. Storytelling

	measure 'Title | p6_vis01' = Nexora.RankTitle ( dim_company[company_name], [Production Line Efficiency %], "pct1", 1, 1, "{name} trails at {value} line efficiency vs {total} for the group" )
		displayFolder: 90. Storytelling

	measure 'Title | p6_vis02' = Nexora.TwoRatio ( [Total Workforce Payroll (USD)], [Active Headcount], "Since {y0}, payroll grew {a} while headcount grew only {b}" )
		displayFolder: 90. Storytelling

	measure 'Title | p6_vis03' = Nexora.RankTitle ( fact_workforce_monthly[department_name], [Total Workforce Payroll (USD)], "usd", 0, 1, "{name} absorbs {share} of payroll" )
		displayFolder: 90. Storytelling

	measure 'Title | p7_vis01' = Nexora.RankTitle ( dim_company[company_name], [AQL Defect Rate %], "pct1", 0, 1, "{name} has the highest defect rate at {value} vs {total} for the group" )
		displayFolder: 90. Storytelling

	measure 'Title | p7_vis02' = Nexora.RankTitle ( fact_shipment_line[delay_reason], [Late Shipped Quantity (PCS)], "cnt", 0, 1, "{name} causes {share} of late shipment volume" )
		displayFolder: 90. Storytelling

	measure 'Title | p7_vis03' = "Air freight carries " & FORMAT ( [Air Freight Revenue Share %], "0.0%" ) & " of revenue, the costly exception lane"
		displayFolder: 90. Storytelling

	measure 'Title | p8_vis01' = "Direct material makes up " & FORMAT ( DIVIDE ( [Direct Material Cost (USD)], [Total Cost Ledger (USD)] ), "0%" ) & " of total cost, the biggest lever on margin"
		displayFolder: 90. Storytelling

	measure 'Title | p8_vis02' = Nexora.TrendTitle ( [Carbon Footprint (kg CO2e/PC)], "Carbon per garment (kg CO2e)", "n3", "rose", "fell", 1 )
		displayFolder: 90. Storytelling

	measure 'Title | p8_vis03' = "Gross margin keeps " & FORMAT ( [Operational Gross Margin %], "0%" ) & " of revenue; direct material takes " & FORMAT ( DIVIDE ( [Direct Material Cost (USD)], [Shipped FOB Revenue (USD)] ), "0%" )
		displayFolder: 90. Storytelling

	measure 'Color | p1_vis03' = Nexora.BarColor ( dim_company[company_name], [Operational Gross Margin %], 1, 1, "#B54708" )
		displayFolder: 90. Storytelling

