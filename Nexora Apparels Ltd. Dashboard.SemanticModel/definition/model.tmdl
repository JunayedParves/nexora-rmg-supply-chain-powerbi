model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["Executive_Measures", "dim_date", "dim_company", "dim_factory", "dim_factory_line", "dim_buyer", "dim_supplier", "dim_product", "dim_material", "dim_cost_category", "dim_order_line", "fact_sales_order_line", "fact_purchase_order_line", "fact_supplier_delivery", "fact_production_batch", "fact_material_consumption", "fact_quality_inspection", "fact_shipment_line", "fact_inventory_snapshot_monthly", "fact_cost_transaction", "fact_workforce_monthly", "fact_sustainability_monthly", "fact_macro_monthly"]

ref table Executive_Measures
ref table dim_date
ref table dim_company
ref table dim_factory
ref table dim_factory_line
ref table dim_buyer
ref table dim_supplier
ref table dim_product
ref table dim_material
ref table dim_cost_category
ref table dim_order_line
ref table fact_sales_order_line
ref table fact_purchase_order_line
ref table fact_supplier_delivery
ref table fact_production_batch
ref table fact_material_consumption
ref table fact_quality_inspection
ref table fact_shipment_line
ref table fact_inventory_snapshot_monthly
ref table fact_cost_transaction
ref table fact_workforce_monthly
ref table fact_sustainability_monthly
ref table fact_macro_monthly

ref cultureInfo en-US

